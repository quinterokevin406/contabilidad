# Without this file, `COPY . .` bakes the developer's .env — AUTH_SECRET and the
# database password — into an image layer, where anyone who can pull the image
# can read it back out. Deleting it in a later layer does not remove it.

.env
.env.*
!.env.example

node_modules
.next
out
build

.git
.gitignore

