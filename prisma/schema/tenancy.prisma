// ---------------------------------------------------------------------------
// Tenancy, identity and per-organization configuration.
//
// Every business-domain row carries organizationId from the very first
// migration. Retrofitting tenant isolation into a ledger that already holds
// real money is the migration nobody survives, so it is here from day one even
// though the first deployments are one organization per install.
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(cuid())
  /// URL-safe identifier, also used to scope receipt numbering.
  slug      String             @unique
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  settings              OrganizationSettings?
  users                 User[]
  clients               Client[]
  clientTags            ClientTag[]
  loans                 Loan[]
  loanPeriods           LoanPeriod[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  renewals              Renewal[]
  settlements           Settlement[]
  cashAccounts          CashAccount[]
  cashMovements         CashMovement[]
  transactionCategories TransactionCategory[]
  incomeEntries         IncomeEntry[]
  expenseEntries        ExpenseEntry[]
  capitalEvents         CapitalEvent[]
  paymentMethods        PaymentMethod[]
  cashClosures          CashClosure[]
  periodSnapshots       PeriodSnapshot[]
  snapshotMetrics       PeriodSnapshotMetric[]
  goals                 Goal[]
  alertRules            AlertRule[]
  alertEvents           AlertEvent[]
  auditLogs             AuditLog[]
  reversals             Reversal[]
  notifications         Notification[]
  receiptSequences      ReceiptSequence[]
  idempotencyKeys       IdempotencyKey[]

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String
  name           String
  /// Argon2id hash. Never a plaintext or reversible value.
  passwordHash   String
  role           UserRole   @default(ADMIN)
  status         UserStatus @default(ACTIVE)
  /// Bumped to invalidate every issued token for this user at once.
  sessionVersion Int        @default(1)
  lastLoginAt    DateTime?
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  archivedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedClients Client[]         @relation("ClientAssignedCollector")
  createdLoans    Loan[]           @relation("LoanCreatedBy")
  payments        Payment[]
  renewals        Renewal[]
  settlements     Settlement[]
  cashMovements   CashMovement[]
  incomeEntries   IncomeEntry[]
  expenseEntries  ExpenseEntry[]
  capitalEvents   CapitalEvent[]
  cashClosures    CashClosure[]
  periodSnapshots PeriodSnapshot[]
  auditLogs       AuditLog[]
  reversals       Reversal[]
  alertEvents     AlertEvent[]     @relation("AlertAcknowledgedBy")
  sessions        Session[]
  accounts        Account[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@map("users")
}

// --- Auth.js adapter tables ------------------------------------------------
// The credentials flow uses a JWT strategy, but these tables exist from the
// start so adding OAuth or database-backed sessions later is a config change
// and not a migration against live financial data.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Organization configuration --------------------------------------------

model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  businessName String
  logoUrl      String?
  /// ISO 4217. COP for every Colombian deployment.
  currencyCode String  @default("COP")
  /// IANA zone. All day boundaries (today's collections, daily closure) are
  /// resolved in this zone, never in the server local zone.
  timeZone     String  @default("America/Bogota")
  locale       String  @default("es-CO")

  // Defaults offered when creating a loan. Copied onto the loan at creation
  // time; changing them here never touches an existing loan.
  defaultInterestMethod     InterestMethod     @default(SIMPLE_ON_ORIGINAL_PRINCIPAL)
  defaultPeriodicity        Periodicity        @default(MONTHLY)
  defaultAllocationStrategy AllocationStrategy @default(INTEREST_FIRST)
  defaultPeriodAnchor       PeriodAnchor       @default(CALENDAR)
  defaultRoundingMode       RoundingMode       @default(HALF_UP)
  /// Early settlement charges the period in progress in full by default. The
  /// operator can override this on an individual settlement, and the value
  /// actually applied is recorded on the Settlement row.
  defaultOpenPeriodPolicy   OpenPeriodPolicy   @default(FULL_PERIOD)
  /// A renewal keeps the contract rhythm by default: a loan due the 24th stays
  /// due the 24th even when the client pays late.
  defaultRenewalDueBasis    RenewalDueBasis    @default(PREVIOUS_DUE_DATE)
  /// Smallest representable money unit, in currency units. "1" means whole
  /// pesos: every computed amount is rounded to an integer peso.
  moneyQuantum              Decimal            @default("1") @db.Decimal(18, 2)

  /// Days before a due date at which a loan is flagged DUE_SOON.
  dueSoonLeadDays  Int @default(3)
  /// Grace days after the due date before a loan is flagged OVERDUE.
  overdueGraceDays Int @default(0)

  /// Optional administrative warning threshold for point 60. Purely advisory:
  /// the system never alters a rate or a balance on its own.
  rateReviewThresholdPercent Decimal? @db.Decimal(9, 4)
  rateReviewNote             String?

  receiptPrefix String @default("REC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// Admin-definable payment methods (point 88). Cash and transfer are seeded.
model PaymentMethod {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// Stable machine key for seeded rows; null for admin-created ones.
  systemKey      String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("payment_methods")
}

/// Gap-free receipt numbering, incremented inside the payment transaction.
model ReceiptSequence {
  id             String   @id @default(cuid())
  organizationId String
  /// Namespace, e.g. "PAYMENT".
  scope          String
  prefix         String
  /// Last number handed out. The next receipt is lastNumber + 1.
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope])
  @@map("receipt_sequences")
}

/// Idempotency guard for point 51: a double click, a form resubmit or a retry
/// must never post the same payment or disbursement twice.
model IdempotencyKey {
  id             String   @id @default(cuid())
  organizationId String
  /// Client-supplied key, unique per operation attempt.
  key            String
  /// Logical operation, e.g. "payment.create".
  operation      String
  /// Primary key of the row the first successful attempt produced.
  resultId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, operation])
  @@map("idempotency_keys")
}
