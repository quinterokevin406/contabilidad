# -----------------------------------------------------------------------------
# CAPITAL CONTROL - environment template
# Copy to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://capital:change-me@localhost:5432/capital_control?schema=public"

# Unpooled connection, used ONLY by migrations and the seed.
#
# Leave it empty on a plain install: there is no pooler, so it is the same
# string as above. On a managed database (Supabase, Neon) the app connects
# through the pooled URL and the CLI needs the direct one, because a pooler in
# transaction mode cannot run schema changes.
DIRECT_URL=""

# Auth.js secret. Generate a fresh one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-32-byte-random-value"

# Public base URL of this deployment.
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Docker deployment only (see docs/DEPLOY.md). Ignored when running with npm.
# -----------------------------------------------------------------------------

# Hostname pointing at this server. Caddy obtains a TLS certificate for it and
# AUTH_URL is derived from it. Use "localhost" to try the stack without a domain.
APP_DOMAIN="localhost"

# -----------------------------------------------------------------------------
# Installation on a local network (one PC, phones on the same WiFi)
# -----------------------------------------------------------------------------

# Allows the session cookie over plain http://.
#
# Set to "true" ONLY for an installation inside a home or office network, where
# there is no domain and therefore no certificate. Without it the browser
# discards the session and the login form silently returns to itself.
#
# NEVER on anything reachable from the internet: the session token would cross
# the network in the clear. See docs/INSTALAR-EN-PC.md.
ALLOW_INSECURE_COOKIES="false"

# Password for the PostgreSQL container. Generate one, do not invent it:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=""

# Server time zone, used for log timestamps.
TZ="America/Bogota"

# Bootstrap administrator, used only by the seed on a fresh database.
SEED_ADMIN_EMAIL="admin@capitalcontrol.local"
SEED_ADMIN_PASSWORD="change-me-before-first-login"
SEED_ADMIN_NAME="Administrador"

# Organization created by the seed.
SEED_ORG_NAME="Mi Negocio"
SEED_ORG_SLUG="mi-negocio"

# Set to "true" to also load the demo dataset. Never enable in production.
SEED_DEMO_DATA="false"
