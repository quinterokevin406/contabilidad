# -----------------------------------------------------------------------------
# CAPITAL CONTROL - environment template
# Copy to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://capital:change-me@localhost:5432/capital_control?schema=public"

# Auth.js secret. Generate a fresh one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-32-byte-random-value"

# Public base URL of this deployment.
AUTH_URL="http://localhost:3000"

# Bootstrap administrator, used only by the seed on a fresh database.
SEED_ADMIN_EMAIL="admin@capitalcontrol.local"
SEED_ADMIN_PASSWORD="change-me-before-first-login"
SEED_ADMIN_NAME="Administrador"

# Organization created by the seed.
SEED_ORG_NAME="Mi Negocio"
SEED_ORG_SLUG="mi-negocio"

# Set to "true" to also load the demo dataset. Never enable in production.
SEED_DEMO_DATA="false"
