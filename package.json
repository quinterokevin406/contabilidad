{
  "name": "capital-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/pg.mjs start",
    "db:stop": "node scripts/pg.mjs stop",
    "db:status": "node scripts/pg.mjs status",
    "db:psql": "node scripts/pg.mjs psql",
    "verify:ledger": "tsx --conditions=react-server --env-file=.env scripts/verify-client-detail.mts",
    "verify:payments": "tsx --conditions=react-server --env-file=.env scripts/verify-payment-flow.mts",
    "verify": "npm run test && npm run typecheck && npm run verify:ledger && npm run verify:payments && npm run verify:lifecycle && npm run verify:cash && npm run verify:collections && npm run verify:analytics && npm run verify:reports && npm run verify:reversals",
    "verify:lifecycle": "tsx --conditions=react-server --env-file=.env scripts/verify-lifecycle.mts",
    "verify:cash": "tsx --conditions=react-server --env-file=.env scripts/verify-cash.mts",
    "verify:collections": "tsx --conditions=react-server --env-file=.env scripts/verify-collections.mts",
    "db:closures": "tsx --conditions=react-server --env-file=.env scripts/backfill-closures.mts",
    "verify:analytics": "tsx --conditions=react-server --env-file=.env scripts/verify-analytics.mts",
    "verify:reports": "tsx --conditions=react-server --env-file=.env scripts/verify-reports.mts",
    "verify:reversals": "tsx --conditions=react-server --env-file=.env scripts/verify-reversals.mts",
    "backup": "node scripts/backup.mjs create",
    "backup:list": "node scripts/backup.mjs list",
    "backup:restore": "node scripts/backup.mjs restore",
    "postinstall": "prisma generate --config prisma7.config.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  }
}
